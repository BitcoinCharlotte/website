---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const dirPath = path.join(process.cwd(), 'content', 'events');
const events = fs.readdirSync(dirPath)
  .filter((f: string) => f.endsWith('.yaml'))
  .map((f: string) => yaml.load(fs.readFileSync(path.join(dirPath, f), 'utf-8')) as any);

// Group by type
const grouped: Record<string, any[]> = {};
events.forEach((e: any) => {
  const t = e.type || 'other';
  if (!grouped[t]) grouped[t] = [];
  grouped[t].push(e);
});
const typeLabels: Record<string, string> = {
  recurring: 'Recurring Events',
  special: 'Special Events',
  other: 'Other Events',
};
---
<Base title="Events — Bitcoin Charlotte">

  <h2 class="btc-section-title">Events</h2>
  <p style="margin-bottom:24px; color:#5a5a7a;">Join us at our regular meetups and special events around Charlotte.</p>

  {Object.entries(grouped).map(([type, items]) => (
    <div style="margin-bottom:36px;">
      <h3 style="font-family:'Bebas Neue',sans-serif; font-size:24px; color:#41449f; margin-bottom:14px;">
        {typeLabels[type] || type}
      </h3>
      <div class="btc-grid">
        {items.map((e: any) => (
          <EventCard
            title={e.title}
            schedule={e.schedule}
            location={e.location}
            description={e.description}
            type={e.type}
          />
        ))}
      </div>
    </div>
  ))}

  <div class="btc-cta">
    <h3>Join Us</h3>
    <p>RSVP on Meetup to get notified about upcoming events.</p>
    <a href="https://meetup.com/bitcoincharlotte" target="_blank" rel="noopener" class="btc-btn">RSVP on Meetup</a>
  </div>

</Base>
