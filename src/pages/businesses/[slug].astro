---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

export function getStaticPaths() {
  const dirPath = path.join(process.cwd(), 'content', 'businesses');
  const businesses = fs.readdirSync(dirPath)
    .filter((f: string) => f.endsWith('.yaml'))
    .map((f: string) => yaml.load(fs.readFileSync(path.join(dirPath, f), 'utf-8')) as any);
  return businesses.map((b: any) => ({ params: { slug: b.slug }, props: { business: b } }));
}

const { business } = Astro.props;
const b = business;
const neighborhood = b.location?.neighborhood;
---
<Base title={`${b.name} — Bitcoin Charlotte`}>

  <div style="margin-bottom:36px;">
    <a href="/businesses" style="font-size:13px; color:#41449f;">← All Businesses</a>
  </div>

  <div style="display:flex; gap:20px; align-items:flex-start; margin-bottom:24px;">
    {b.logo && (
      <img src={b.logo} alt={b.name} width="80" height="80" style="border-radius:10px; object-fit:cover; flex-shrink:0;" />
    )}
    <div>
      <h2 style="font-family:'Bebas Neue',sans-serif; font-size:38px; color:#1a1a2e; margin:0 0 8px 0;">{b.name}</h2>
      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px;">
        {(b.badges || []).map((badge: string) => (
          <span class={`btc-badge ${badge === 'holds-bitcoin' ? 'btc-badge-orange' : badge === 'lightning' ? 'btc-badge-purple' : 'btc-badge-light'}`}>
            {badge.replace(/-/g, ' ')}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="btc-card" style="margin-bottom:24px;">
    <p style="font-size:15px; line-height:1.7; color:#5a5a7a;">{b.description}</p>
  </div>

  <div class="btc-grid-2" style="margin-bottom:36px;">
    {b.website && (
      <div class="btc-card">
        <h3>Website</h3>
        <p><a href={b.website} target="_blank" rel="noopener noreferrer">{b.website}</a></p>
      </div>
    )}
    {neighborhood && (
      <div class="btc-card">
        <h3>Neighborhood</h3>
        <p>📍 {neighborhood}</p>
        {b.location?.address && <p style="font-size:13px; color:#999;">{b.location.address}</p>}
      </div>
    )}
  </div>

  {b.slug && (
    <p>
      <a href={`https://btcmap.org/merchant/${b.slug}`} target="_blank" rel="noopener noreferrer" class="btc-btn-purple">
        View on BTC Map
      </a>
    </p>
  )}

</Base>
