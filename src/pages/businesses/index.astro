---
import Base from '../../layouts/Base.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const dirPath = path.join(process.cwd(), 'content', 'businesses');
const businesses = fs.readdirSync(dirPath)
  .filter((f: string) => f.endsWith('.yaml'))
  .map((f: string) => yaml.load(fs.readFileSync(path.join(dirPath, f), 'utf-8')) as any)
  .sort((a: any, b: any) => a.name.localeCompare(b.name));
---
<Base title="Bitcoin Businesses in Charlotte — Bitcoin Charlotte">

  <h2 class="btc-section-title">Bitcoin Businesses in Charlotte</h2>
  <p style="margin-bottom:24px; color:#5a5a7a;">{businesses.length} businesses accepting Bitcoin in the Queen City.</p>

  <div class="btc-grid-2">
    {businesses.map((b: any) => (
      <BusinessCard
        name={b.name}
        slug={b.slug}
        description={b.description}
        badges={b.badges}
        website={b.website}
        location={b.location}
        logo={b.logo}
      />
    ))}
  </div>

</Base>
