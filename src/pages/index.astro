---
import Base from '../layouts/Base.astro';
import BusinessCard from '../components/BusinessCard.astro';
import EventCard from '../components/EventCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

function loadYamlDir(dir: string) {
  const dirPath = path.join(process.cwd(), 'content', dir);
  if (!fs.existsSync(dirPath)) return [];
  return fs.readdirSync(dirPath)
    .filter((f: string) => f.endsWith('.yaml'))
    .map((f: string) => yaml.load(fs.readFileSync(path.join(dirPath, f), 'utf-8')) as any);
}

const events = loadYamlDir('events');
const businesses = loadYamlDir('businesses')
  .filter((b: any) => b.badges?.includes('holds-bitcoin'))
  .slice(0, 6);
const businessCount = loadYamlDir('businesses').length;
---
<Base title="Bitcoin Charlotte — Queen City's Bitcoin Community">

  <!-- Hero -->
  <section class="btc-hero">
    <h2>Bitcoin <span>Charlotte</span></h2>
    <p class="btc-hero-sub">Queen City's Bitcoin community. Education, meetups, and merchant adoption.</p>
    <div class="btc-hero-body">
      <p>We're a grassroots group of Bitcoiners helping Charlotte businesses accept Bitcoin, hosting regular meetups and seminars, and sharing free educational resources. Whether you're a seasoned hodler or just Bitcoin-curious, you're welcome here.</p>
    </div>
    <div style="margin-top:24px; display:flex; flex-wrap:wrap; gap:12px;">
      <a href="/events" class="btc-btn">Upcoming Events</a>
      <a href="/onboarding-100" class="btc-btn-secondary" style="color:#fff; border-color:rgba(255,255,255,0.4);">Accept Bitcoin</a>
    </div>
  </section>

  <!-- Upcoming Events -->
  <h2 class="btc-section-title">Upcoming Events</h2>
  <div class="btc-grid" style="margin-bottom:36px;">
    {events.slice(0, 3).map((e: any) => (
      <EventCard
        title={e.title}
        schedule={e.schedule}
        location={e.location}
        description={e.description}
        type={e.type}
      />
    ))}
  </div>

  <!-- Bitcoin Businesses -->
  <h2 class="btc-section-title">Bitcoin Businesses</h2>
  <div class="btc-grid-2" style="margin-bottom:16px;">
    {businesses.map((b: any) => (
      <BusinessCard
        name={b.name}
        slug={b.slug}
        description={b.description}
        badges={b.badges}
        website={b.website}
        location={b.location}
        logo={b.logo}
      />
    ))}
  </div>
  <p style="text-align:right; margin-bottom:36px;">
    <a href="/businesses" style="font-weight:600;">View all {businessCount} businesses →</a>
  </p>

  <!-- Onboarding 100 Progress -->
  <div class="btc-progress-wrap">
    <div class="btc-progress-header">
      <span class="btc-progress-label">Onboarding 100 Businesses</span>
      <span class="btc-progress-count" id="progress-count">9 <span>/ 100</span></span>
    </div>
    <div class="btc-progress-track">
      <div class="btc-progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
    <p class="btc-progress-sub">Help us get <strong>100 Charlotte businesses</strong> accepting Bitcoin</p>
  </div>
  <p style="text-align:center; margin-bottom:36px;">
    <a href="/onboarding-100" class="btc-btn">Learn About Onboarding 100</a>
  </p>

  <!-- Support -->
  <h2 class="btc-section-title">Support Bitcoin Charlotte</h2>
  <div class="btc-grid-2" style="margin-bottom:36px;">
    <div class="btc-card">
      <h3>Community Support</h3>
      <p>We run completely from volunteers and donations. Every contribution helps us host events and grow the Bitcoin community in Charlotte.</p>
      <a href="/community-support" class="btc-btn-purple" style="margin-top:8px;">Get Involved</a>
    </div>
    <div class="btc-card">
      <h3>Official Merch</h3>
      <p>Rep Bitcoin Charlotte with official gear! T-shirts, hats, and more by Proof of Ink.</p>
      <a href="https://proofofink.com/bitcoin-charlotte/" target="_blank" rel="noopener" class="btc-btn-purple" style="margin-top:8px;">Shop Merch</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const fill = document.getElementById('progress-fill');
      if (fill) {
        setTimeout(() => { fill.style.width = '9%'; }, 200);
      }
    });
  </script>
</Base>
