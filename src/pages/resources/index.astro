---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const dirPath = path.join(process.cwd(), 'content', 'resources');
const resources = fs.readdirSync(dirPath)
  .filter((f: string) => f.endsWith('.yaml'))
  .map((f: string) => yaml.load(fs.readFileSync(path.join(dirPath, f), 'utf-8')) as any);

const featured = resources.find((r: any) => r.featured);
const grouped: Record<string, any[]> = {};
resources.filter((r: any) => !r.featured).forEach((r: any) => {
  const cat = r.category || 'other';
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(r);
});

function catLabel(cat: string) {
  return cat.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
}
---
<Base title="Resources — Bitcoin Charlotte">

  <h2 class="btc-section-title">Resources</h2>
  <p style="margin-bottom:24px; color:#5a5a7a;">Curated Bitcoin resources — wallets, guides, books, podcasts, and more.</p>

  <!-- Featured -->
  {featured && (
    <div class="btc-reward" style="margin-bottom:36px;">
      <p class="btc-reward-label">Featured Resource</p>
      <p class="btc-reward-amount" style="font-size:clamp(28px,4vw,42px);">{featured.title}</p>
      <p class="btc-reward-desc">{featured.description}</p>
      <a href={featured.url} class="btc-btn" style="margin-top:16px;">
        Read Now
      </a>
    </div>
  )}

  {Object.entries(grouped).sort(([a],[b]) => a.localeCompare(b)).map(([cat, items]) => (
    <div style="margin-bottom:32px;">
      <h3 class="btc-section-title" style="font-size:22px;">{catLabel(cat)}</h3>
      <ul class="btc-resources">
        {items.map((r: any) => (
          <li>
            <p>
              <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
              {r.type && <span class="btc-badge btc-badge-light" style="margin-left:8px;">{r.type}</span>}
            </p>
            {r.author && <p class="btc-res-sub">by {r.author}</p>}
            {r.description && <p class="btc-res-sub">{r.description}</p>}
          </li>
        ))}
      </ul>
    </div>
  ))}

</Base>
