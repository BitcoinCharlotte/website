---
interface Props {
  title: string;
  url: string;
  type?: string;
  author?: string;
  description?: string;
}
const { title, url, type, author, description } = Astro.props;
---
<div class="btc-card">
  <p style="margin:0 0 4px 0;">
    <a href={url} target="_blank" rel="noopener noreferrer" style="font-weight:600; font-size:15px;">{title}</a>
  </p>
  {type && <span class="btc-badge btc-badge-light" style="margin-bottom:6px;">{type}</span>}
  {author && <p style="font-size:12.5px; color:#999; margin:4px 0 2px 0;">by {author}</p>}
  {description && <p>{description}</p>}
</div>
