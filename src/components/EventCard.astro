---
interface Props {
  title: string;
  schedule?: { rule?: string; time?: string; frequency?: string };
  location?: { name?: string; neighborhood?: string; address?: string };
  description: string;
  type?: string;
}
const { title, schedule, location, description, type } = Astro.props;
const truncated = description && description.length > 140 ? description.slice(0, 140).trim() + '…' : description;
const scheduleStr = schedule?.rule ? `${schedule.rule}${schedule.time ? ' @ ' + schedule.time : ''}` : '';
const locationStr = location?.name || '';
---
<div class="btc-card">
  <h3>{title}</h3>
  {type && <span class="btc-badge btc-badge-purple" style="margin-bottom:8px;">{type}</span>}
  {scheduleStr && <p style="margin:6px 0 4px 0;">📅 {scheduleStr}</p>}
  {locationStr && <p style="margin:0 0 6px 0;">📍 {locationStr}{location?.neighborhood ? `, ${location.neighborhood}` : ''}</p>}
  {truncated && <p>{truncated}</p>}
</div>
