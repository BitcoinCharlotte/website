---
interface Props {
  title: string;
  subtitle: string;
  body?: string;
}
const { title, subtitle, body } = Astro.props;
---
<section class="btc-hero">
  <svg class="btc-hero-watermark" width="260" height="260" viewBox="0 0 260 260" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <text x="50%" y="55%" dominant-baseline="central" text-anchor="middle" font-family="'Bebas Neue', sans-serif" font-size="220" font-weight="bold" fill="white" opacity="0.07">₿</text>
  </svg>
  <h2 class="btc-hero-title">
    <slot name="title">
      <Fragment set:html={title} />
    </slot>
  </h2>
  <p class="btc-hero-sub">{subtitle}</p>
  {body && <p class="btc-hero-body">{body}</p>}
</section>

<style>
  .btc-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #41449f, #2d2f7a);
    border-radius: 14px;
    padding: 3.5rem 2.5rem;
    color: #ffffff;
    margin-bottom: 2rem;
  }

  .btc-hero-watermark {
    position: absolute;
    right: -30px;
    top: -30px;
    width: 260px;
    height: 260px;
    pointer-events: none;
  }

  .btc-hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 0.75rem;
    line-height: 1.1;
    position: relative;
    z-index: 1;
  }

  .btc-hero-title :global(span) {
    color: #F7931A;
  }

  .btc-hero-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.15rem;
    opacity: 0.9;
    margin: 0 0 0.75rem;
    max-width: 640px;
    position: relative;
    z-index: 1;
  }

  .btc-hero-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    opacity: 0.8;
    margin: 0;
    max-width: 640px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .btc-hero {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
