---
interface Props {
  name: string;
  slug: string;
  description: string;
  badges?: string[];
  website?: string;
  location?: { neighborhood?: string; address?: string; name?: string };
  hodlsBitcoin?: boolean;
  logo?: string;
}
const { name, slug, description, badges = [], location, logo } = Astro.props;
const truncated = description && description.length > 120 ? description.slice(0, 120).trim() + '…' : description;
const neighborhood = location?.neighborhood;
---
<a href={`/businesses/${slug}`} class="btc-card btc-business-card" style="text-decoration:none; display:flex; gap:14px; align-items:flex-start;">
  {logo && (
    <img src={logo} alt={name} width="48" height="48" style="border-radius:6px; object-fit:cover; flex-shrink:0;" loading="lazy" />
  )}
  <div style="min-width:0;">
    <h3 style="margin:0 0 4px 0;">{name}</h3>
    {truncated && <p style="margin:0 0 6px 0;">{truncated}</p>}
    <div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:4px;">
      {badges.map((b) => (
        <span class={`btc-badge ${b === 'holds-bitcoin' ? 'btc-badge-orange' : b === 'lightning' ? 'btc-badge-purple' : 'btc-badge-light'}`}>
          {b.replace(/-/g, ' ')}
        </span>
      ))}
    </div>
    {neighborhood && <p style="font-size:12px; color:#5a5a7a; margin:0;">📍 {neighborhood}</p>}
  </div>
</a>
