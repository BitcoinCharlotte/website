---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: '/events' },
  { label: 'Resources', href: '/resources' },
  { label: 'Businesses', href: '/businesses' },
  { label: 'Onboarding 100', href: '/onboarding-100' },
];

const communityLinks = [
  { label: 'Meetup', href: 'https://meetup.com/bitcoincharlotte' },
  { label: 'Telegram', href: 'https://t.me/+0GOZLahvOPhlZmIx' },
  { label: 'Nostr', href: 'https://primal.net/bitcoincharlotte' },
];

const socialLinks = [
  { label: 'X', href: 'https://x.com/Bitcoin_CLT' },
  { label: 'Instagram', href: 'https://instagram.com/bitcoincharlotte' },
  { label: 'Facebook', href: 'https://facebook.com/BitcoinCLT' },
  { label: 'LinkedIn', href: 'https://linkedin.com/company/bitcoincharlotte' },
];
---
<footer class="btc-footer">
  <div class="btc-footer-inner">
    <div class="btc-footer-brand">
      <img src="/images/logo.svg" alt="Bitcoin Charlotte" height="48" width="48" class="btc-footer-logo" />
      <p class="btc-footer-tagline">Grassroots Bitcoin adoption in Charlotte, NC</p>
    </div>

    <div class="btc-footer-columns">
      <div class="btc-footer-col">
        <h4>Navigate</h4>
        <ul>
          {navLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="btc-footer-col">
        <h4>Community</h4>
        <ul>
          {communityLinks.map(link => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="btc-footer-col">
        <h4>Follow Us</h4>
        <ul>
          {socialLinks.map(link => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="btc-footer-bottom">
      <p>MIT License · Open Source · Paid for with ₿</p>
    </div>
  </div>
</footer>

<style>
  .btc-footer {
    background: linear-gradient(135deg, #41449f, #2d2f7a);
    border-radius: 14px 14px 0 0;
    color: #ffffff;
    margin-top: 4rem;
  }

  .btc-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .btc-footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btc-footer-logo {
    height: 48px;
    width: auto;
  }

  .btc-footer-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    opacity: 0.85;
    margin: 0;
  }

  .btc-footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .btc-footer-col h4 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
    color: #F7931A;
  }

  .btc-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .btc-footer-col li {
    margin-bottom: 0.5rem;
  }

  .btc-footer-col a {
    color: #ffffff;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .btc-footer-col a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .btc-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1.5rem;
    text-align: center;
  }

  .btc-footer-bottom p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    opacity: 0.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .btc-footer-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .btc-footer-brand {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
