---
const pathname = Astro.url.pathname;

const links = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: '/events' },
  { label: 'Resources', href: '/resources' },
  { label: 'Businesses', href: '/businesses' },
  { label: 'Onboarding 100', href: '/onboarding-100' },
];
---

<header class="nav-header">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo">
      <img src="/images/logo.svg" alt="Bitcoin Charlotte" width="48" height="48" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
      <span class="hamburger"></span>
    </label>

    <ul class="nav-links">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { active: pathname === href || (href !== '/' && pathname.startsWith(href)) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #12121f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }

  .nav-logo img {
    max-height: 48px;
    width: auto;
    display: block;
  }

  /* Hamburger checkbox hack */
  .nav-toggle-checkbox {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    position: relative;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before {
    top: -7px;
  }

  .hamburger::after {
    top: 7px;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 6px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: #f7931a;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .nav-toggle-label {
      display: flex;
      align-items: center;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: #12121f;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.5rem 1.5rem 1rem;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
    }

    .nav-toggle-checkbox:checked ~ .nav-links {
      max-height: 400px;
      opacity: 1;
      padding: 0.5rem 1.5rem 1rem;
    }

    /* Animate hamburger to X */
    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger {
      background: transparent;
    }

    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger::before {
      top: 0;
      transform: rotate(45deg);
    }

    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .nav-link {
      padding: 0.65rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
  }
</style>
