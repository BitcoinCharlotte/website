---
const pathname = Astro.url.pathname;
const links = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: '/events' },
  { label: 'Resources', href: '/resources' },
  { label: 'Businesses', href: '/businesses' },
  { label: 'Onboarding 100', href: '/onboarding-100' },
];
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<nav class="btc-nav">
  <div class="btc-nav-inner">
    <a href="/" class="btc-nav-logo">
      <img src="/images/logo.svg" alt="Bitcoin Charlotte" height="40" width="40" />
    </a>

    <input type="checkbox" id="nav-toggle" class="btc-nav-checkbox" aria-hidden="true" />
    <label for="nav-toggle" class="btc-nav-hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="btc-nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['btc-nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .btc-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    border-bottom: 1px solid #e2e2ee;
  }

  .btc-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
  }

  .btc-nav-logo img {
    display: block;
    height: 40px;
    width: auto;
  }

  .btc-nav-checkbox {
    display: none;
  }

  .btc-nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    width: 32px;
    height: 32px;
    z-index: 10;
  }

  .btc-nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #41449f;
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .btc-nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .btc-nav-link {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #41449f;
    text-decoration: none;
    transition: color 0.2s;
  }

  .btc-nav-link:hover,
  .btc-nav-link.active {
    color: #F7931A;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .btc-nav-hamburger {
      display: flex;
    }

    .btc-nav-links {
      position: fixed;
      top: 0;
      right: 0;
      width: 260px;
      height: 100vh;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 80px 2rem 2rem;
      background: #ffffff;
      border-left: 1px solid #e2e2ee;
      box-shadow: -4px 0 20px rgba(0, 0, 0, 0.08);
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }

    .btc-nav-links li {
      width: 100%;
    }

    .btc-nav-links .btc-nav-link {
      display: block;
      padding: 0.75rem 0;
      font-size: 18px;
      border-bottom: 1px solid #e2e2ee;
    }

    .btc-nav-checkbox:checked ~ .btc-nav-links {
      transform: translateX(0);
    }

    .btc-nav-checkbox:checked ~ .btc-nav-hamburger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .btc-nav-checkbox:checked ~ .btc-nav-hamburger span:nth-child(2) {
      opacity: 0;
    }

    .btc-nav-checkbox:checked ~ .btc-nav-hamburger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
